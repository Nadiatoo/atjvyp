{事不过三·突破形态选股公式}
{基于真如铁真技术体系——固定历史压力位+三次试探+第三次放量突破}
{参数可调: N1压力位回看 N2近期排除 N3均量周期 N4放量倍数}

N1 := 60;    {压力位取自N1天前的最高价}
N2 := 10;    {排除最近N2天（防止把新高当压力）}
N3 := 5;     {均量周期}
N4 := 1.5;   {放量倍数}

{=== 均线 ===}
MA5  := MA(CLOSE, 5);
MA10 := MA(CLOSE, 10);
MA20 := MA(CLOSE, 20);
MA60 := MA(CLOSE, 60);

{=== 成交量 ===}
VOL5  := MA(VOL, N3);
VOL_BOOM := VOL > VOL5 * N4;

{=== KDJ (9,3,3) ===}
RSV := (CLOSE - LLV(LOW, 9)) / (HHV(HIGH, 9) - LLV(LOW, 9)) * 100;
K := SMA(RSV, 3, 1);
D := SMA(K, 3, 1);
KDJ_LONG := K > D AND K > REF(K, 1);

{=== MACD (12,26,9) ===}
DIF := EMA(CLOSE, 12) - EMA(CLOSE, 26);
DEA := EMA(DIF, 9);
MACD := 2 * (DIF - DEA);
MACD_EXPAND := MACD > REF(MACD, 1);

{=== 压力位：取N2~N1天前的最高价（排除近期新高）===}
RES := REF(HHV(HIGH, N1-N2), N2);

{=== 触碰计数：在过去N1天内，COUNT收盘进入压力位±3%的次数 ===}
IN_ZONE := CLOSE >= RES * 0.97 AND CLOSE <= RES * 1.03;
TOUCH_COUNT := COUNT(IN_ZONE, N1);

{=== 平台确认：除今天外，至少有1根K线也触碰过压力位 ===}
PLATFORM := COUNT(IN_ZONE, N1) >= 2;

{=== 当前正在突破 ===}
BREAKING := CLOSE > RES * 0.97 AND CLOSE <= RES * 1.05;

{=== 综合选股信号 ===}
SELECT := VOL_BOOM
          AND KDJ_LONG
          AND MACD_EXPAND
          AND TOUCH_COUNT >= 3
          AND PLATFORM
          AND BREAKING
          AND CLOSE > MA60
          AND CLOSE > OPEN;

SELECT;
